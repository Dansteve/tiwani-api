# FastAPI Settings
APP_NAME=Tiwani API
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Postgres connection string for SQLAlchemy
# Example: postgresql+asyncpg://postgres:password@your-project-id.supabase.co:5432/postgres
DATABASE_URL=

# JWT Settings (If not using Supabase Auth JWT directly)
JWT_SECRET=your-jwt-secret-key-for-local-tokens
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440